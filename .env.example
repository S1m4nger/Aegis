# Go reads process environment; this file is not loaded automatically.
# Paths below assume the working directory services/orchestrator (make go-api).
AEGIS_HTTP_ADDR=127.0.0.1:8080
AEGIS_ML_URL=http://127.0.0.1:8091
AEGIS_RULES_PATH=../../configs/rules.json
AEGIS_POLICY_PATH=../../configs/policy.json
AEGIS_ML_TIMEOUT_MS=2500

# Server-owned dashboard upstream for standalone execution (never visitor input).
AEGIS_API_URL=http://127.0.0.1:8080

# Compose reads these host publication settings from .env; internal URLs are fixed.
# Leave loopback binding for local use; choose a public bind only behind your proxy.
AEGIS_WEB_BIND=127.0.0.1
AEGIS_WEB_PORT=8501
